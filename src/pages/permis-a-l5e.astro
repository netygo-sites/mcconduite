---
import Base from '../layouts/Base.astro';

const jsonLd = [
	[
		{
			"@context": "https://schema.org",
			"@type": "BreadcrumbList",
			"itemListElement": [
				{
					"@type": "ListItem",
					"position": 1,
					"name": "Accueil",
					"item": "https://mcconduite.fr/"
				},
				{
					"@type": "ListItem",
					"position": 2,
					"name": "Permis Moto",
					"item": "https://mcconduite.fr/permis-moto"
				},
				{
					"@type": "ListItem",
					"position": 3,
					"name": "Permis A L5e",
					"item": "https://mcconduite.fr/permis-a-l5e"
				}
			]
		},
		{
			"@context": "https://schema.org",
			"@type": "FAQPage",
			"mainEntity": [
				{
					"@type": "Question",
					"name": "Qu'est-ce qu'un véhicule L5e ?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "Il s'agit des véhicules à trois roues (type scooter 3 roues). Leur conduite nécessite une formation spécifique."
					}
				},
				{
					"@type": "Question",
					"name": "En quoi consiste la formation ?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "Une formation centrée sur la maîtrise du véhicule, l'équilibre et la sécurité. Le détail du programme est précisé lors de votre inscription."
					}
				},
				{
					"@type": "Question",
					"name": "Quels sont les tarifs ?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "Nos tarifs sont communiqués sur demande. Contactez-nous pour en savoir plus et obtenir un devis."
					}
				}
			]
		}
	]
];
---
<Base
	title={"Permis A L5e (3 roues) — MC Conduite Échirolles"}
	description={"Permis A L5e avec MC Conduite : formation dédiée aux véhicules à trois roues (catégorie L5e), centrée sur la maîtrise et la sécurité. Tarifs sur demande."}
	keywords={"auto-école Échirolles, permis Grenoble, MC Conduite"}
	path={"/permis-a-l5e"}
	jsonLd={jsonLd}
>
	<main id="contenu">
	<!-- Header End -->

    <!-- Page Header Section Start -->
    <div class="page-header bg-section dark-section parallaxie">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <!-- Page Header Box Start -->
                    <div class="page-header-box">
                        <h1>Permis A L5e</h1>
                        <nav>
                            <ol class="breadcrumb"><li class="breadcrumb-item"><a href="/">Accueil</a></li><li class="breadcrumb-item"><a href="/permis-moto">Permis Moto</a></li><li class="breadcrumb-item active" aria-current="page">Permis A L5e</li></ol>
                        </nav>
                    </div>
                    <!-- Page Header Box End -->
                </div>
            </div>
        </div>
    </div>
    <!-- Page Header Section End -->

<!-- Page Course Single Start -->
    <div class="page-course-single">
        <div class="container">
            <div class="row">
                <div class="col-lg-4">
                    <div class="page-single-sidebar">
                        <div class="page-category-list wow fadeInUp">
                            <h3>Nos formations Moto</h3>
                            <ul>
                                <li><a href="/code-moto">Code moto (ETM)</a></li>
                                <li><a href="/permis-am">Permis AM</a></li>
                                <li><a href="/permis-a1">Permis A1</a></li>
                                <li><a href="/permis-a2">Permis A2</a></li>
                                <li><a href="/permis-a-l5e">Permis A L5e</a></li>
                            </ul>
                        </div>
                        <div class="sidebar-cta-box wow fadeInUp" data-wow-delay="0.25s">
                            <div class="sidebar-cta-header"><div class="icon-box"><img loading="lazy" decoding="async" src="/images/icon-headphone-accent.svg" alt=""></div><div class="sidebar-cta-header-content"><h3>Appelez-nous : <a href="tel:+33438214802">04 38 21 48 02</a></h3></div></div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-8">
                    <div class="course-single-content">
                        <div class="page-single-image"><figure class="image-anime reveal"><picture><source srcset="/images/mc/logo-mural.webp" type="image/webp"><img loading="lazy" decoding="async" src="/images/mc/logo-mural.jpg" alt="Permis A L5e (3 roues) à Échirolles"></picture></figure></div>

                        <div class="course-entry">
                            <p class="wow fadeInUp">La catégorie L5e concerne les véhicules à trois roues (type scooter 3 roues). Conduire ces véhicules nécessite une formation spécifique : MC Conduite, à Échirolles, vous accompagne pour rouler en toute sécurité.</p>
                            <p class="wow fadeInUp" data-wow-delay="0.2s">La formation est centrée sur la maîtrise du véhicule, l'équilibre et la sécurité, adaptée aux spécificités des trois-roues.</p>

                            <div class="course-info-box">
                                <h2 class="text-anime-style-3">Une formation dédiée aux 3 roues</h2>
                                <p class="wow fadeInUp">Un accompagnement spécifique pour prendre en main un véhicule à trois roues en confiance.</p>
                                <div class="course-info-item-list">
                                    <div class="course-info-item wow fadeInUp" data-wow-delay="0.2s"><div class="icon-box"><img loading="lazy" decoding="async" src="/images/icon-course-info-item-1.svg" alt=""></div><div class="course-info-item-content"><h3>Véhicules L5e</h3><p>Spécifique aux véhicules à trois roues.</p></div></div>
                                    <div class="course-info-item wow fadeInUp" data-wow-delay="0.4s"><div class="icon-box"><img loading="lazy" decoding="async" src="/images/icon-course-info-item-2.svg" alt=""></div><div class="course-info-item-content"><h3>Sécurité &amp; maîtrise</h3><p>Apprentissage centré sur l'équilibre et la conduite en sécurité.</p></div></div>
                                </div>
                                <div class="course-info-images">
                                    <div class="course-info-image"><figure class="image-anime reveal"><picture><source srcset="/images/mc/devanture.webp" type="image/webp"><img loading="lazy" decoding="async" src="/images/mc/devanture.jpg" alt="MC Conduite à Échirolles"></picture></figure></div>
                                    <div class="course-info-image"><figure class="image-anime reveal"><picture><source srcset="/images/mc/header-bg.webp" type="image/webp"><img loading="lazy" decoding="async" src="/images/mc/header-bg.jpg" alt="Route"></picture></figure></div>
                                </div>
                            </div>

                            <div class="course-types-box">
                                <h2 class="text-anime-style-3">À qui s'adresse le permis A L5e</h2>
                                <p class="wow fadeInUp">Pour conduire un véhicule à trois roues en toute légalité et sécurité.</p>
                                <div class="course-type-item-list">
                                    <div class="course-type-item">
                                        <div class="course-type-content-box wow fadeInUp"><div class="course-type-item-header"><div class="icon-box"><img loading="lazy" decoding="async" src="/images/icon-course-type-1.svg" alt=""></div><div class="course-type-no"><h3>01</h3></div></div><div class="course-type-item-body"><h3>Conducteurs de 3 roues</h3><p>Pour les véhicules de la catégorie L5e (type scooter 3 roues).</p><ul><li>Formation spécifique encadrée</li></ul></div></div>
                                        <div class="course-type-image"><figure class="image-anime reveal"><picture><source srcset="/images/mc/photo-road.webp" type="image/webp"><img loading="lazy" decoding="async" src="/images/mc/photo-road.jpg" alt="Conduite d'un 3 roues"></picture></figure></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="page-single-faqs">
                            <div class="section-title"><h2 class="text-anime-style-3" data-cursor="-opaque">Questions fréquentes</h2><p class="wow fadeInUp">Les réponses aux questions les plus courantes sur le permis A L5e.</p></div>
                            <div class="faq-accordion" id="accordion">
                                <div class="accordion-item wow fadeInUp"><h2 class="accordion-header" id="heading1"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapse1" aria-expanded="true" aria-controls="collapse1">Qu'est-ce qu'un véhicule L5e ?</button></h2><div id="collapse1" class="accordion-collapse collapse show" role="region" aria-labelledby="heading1" data-bs-parent="#accordion"><div class="accordion-body"><p>Il s'agit des véhicules à trois roues (type scooter 3 roues). Leur conduite nécessite une formation spécifique.</p></div></div></div>
                                <div class="accordion-item wow fadeInUp" data-wow-delay="0.2s"><h2 class="accordion-header" id="heading2"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse2" aria-expanded="false" aria-controls="collapse2">En quoi consiste la formation ?</button></h2><div id="collapse2" class="accordion-collapse collapse" role="region" aria-labelledby="heading2" data-bs-parent="#accordion"><div class="accordion-body"><p>Une formation centrée sur la maîtrise du véhicule, l'équilibre et la sécurité. Le détail du programme est précisé lors de votre inscription.</p></div></div></div>
                                <div class="accordion-item wow fadeInUp" data-wow-delay="0.4s"><h2 class="accordion-header" id="heading3"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse3" aria-expanded="false" aria-controls="collapse3">Quels sont les tarifs ?</button></h2><div id="collapse3" class="accordion-collapse collapse" role="region" aria-labelledby="heading3" data-bs-parent="#accordion"><div class="accordion-body"><p>Nos tarifs sont communiqués sur demande. Contactez-nous pour en savoir plus et obtenir un devis.</p></div></div></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Page Course Single End -->



    <!-- Avis Google FAB Start -->
    <a class="mc-review-fab" href="https://www.google.com/maps/place/AUTO+ECOLE+MC+CONDUITE/@45.1441566,5.7100222,1331m/data=!3m1!1e3!4m18!1m9!3m8!1s0x478a8b3f6db3fce7:0x4d184686cf363037!2sAUTO+ECOLE+MC+CONDUITE!8m2!3d45.1457321!4d5.7167138!9m1!1b1!16s%2Fg%2F11z21tx4g4!3m7!1s0x478a8b3f6db3fce7:0x4d184686cf363037!8m2!3d45.1457321!4d5.7167138!9m1!1b1!16s%2Fg%2F11z21tx4g4" target="_blank" rel="noopener" aria-label="Laisser un avis sur Google">
        <img loading="lazy" decoding="async" src="/images/icon-google.svg" alt="Google">
        <span class="mc-review-fab-text"><strong>Laissez votre avis</strong><span class="mc-review-fab-stars"><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i></span></span>
    </a>
    <!-- Avis Google FAB End -->
    <!-- Back To Top Start -->
    <a href="#top" class="mc-backtotop" aria-label="Remonter en haut de la page"><i class="fa-solid fa-arrow-up"></i></a>
    <!-- Back To Top End -->

    </main>
</Base>
