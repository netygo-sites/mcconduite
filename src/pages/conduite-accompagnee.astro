---
import Base from '../layouts/Base.astro';

const jsonLd = [
	[
		{
			"@context": "https://schema.org",
			"@type": "BreadcrumbList",
			"itemListElement": [
				{
					"@type": "ListItem",
					"position": 1,
					"name": "Accueil",
					"item": "https://mcconduite.fr/"
				},
				{
					"@type": "ListItem",
					"position": 2,
					"name": "Permis B",
					"item": "https://mcconduite.fr/permis-b"
				},
				{
					"@type": "ListItem",
					"position": 3,
					"name": "Conduite accompagnée (AAC)",
					"item": "https://mcconduite.fr/conduite-accompagnee"
				}
			]
		},
		{
			"@context": "https://schema.org",
			"@type": "FAQPage",
			"mainEntity": [
				{
					"@type": "Question",
					"name": "À partir de quel âge peut-on commencer l'AAC ?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "Dès 15 ans, avec l'accord du représentant légal et de l'assureur. Vous pouvez passer l'examen dès 17 ans et, depuis le 1er janvier 2024, conduire seul(e) dès l'obtention du permis."
					}
				},
				{
					"@type": "Question",
					"name": "Combien de temps dure la phase accompagnée ?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "Au moins un an et 3 000 km, avec deux rendez-vous pédagogiques obligatoires (le premier entre 4 et 6 mois, le second après 3 000 km)."
					}
				},
				{
					"@type": "Question",
					"name": "Qui peut être accompagnateur ?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "Toute personne titulaire du permis B depuis au moins 5 ans sans interruption, avec l'accord de son assureur et mentionnée au contrat. Plusieurs accompagnateurs sont possibles, même hors du cadre familial."
					}
				}
			]
		}
	]
];
---
<Base
	title={"Conduite accompagnée (AAC) à Échirolles — MC Conduite"}
	description={"Conduite accompagnée (AAC) dès 15 ans à Échirolles : conditions, avantages et déroulé. Meilleur taux de réussite et période probatoire réduite. Tarifs sur demande."}
	keywords={"auto-école Échirolles, permis Grenoble, MC Conduite"}
	path={"/conduite-accompagnee"}
	jsonLd={jsonLd}
>
	<main id="contenu">
	<!-- Header End -->

    <!-- Page Header Section Start -->
    <div class="page-header bg-section dark-section parallaxie">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <!-- Page Header Box Start -->
                    <div class="page-header-box">
                        <h1>Conduite accompagnée (AAC) à Échirolles</h1>
                        <nav>
                            <ol class="breadcrumb"><li class="breadcrumb-item"><a href="/">Accueil</a></li><li class="breadcrumb-item"><a href="/permis-b">Permis B</a></li><li class="breadcrumb-item active" aria-current="page">Conduite accompagnée (AAC)</li></ol>
                        </nav>
                    </div>
                    <!-- Page Header Box End -->
                </div>
            </div>
        </div>
    </div>
    <!-- Page Header Section End -->

<!-- Page Course Single Start -->
    <div class="page-course-single">
        <div class="container">
            <div class="row">
                <div class="col-lg-4">
                    <div class="page-single-sidebar">
                        <div class="page-category-list wow fadeInUp">
                            <h3>Nos formations Permis B</h3>
                            <ul>
                                <li><a href="/code-de-la-route">Code de la route</a></li>
                                <li><a href="/boite-manuelle">Boîte manuelle</a></li>
                                <li><a href="/boite-automatique">Boîte automatique</a></li>
                                <li><a href="/conduite-accompagnee">Conduite accompagnée (AAC)</a></li>
                                <li><a href="/conduite-supervisee">Conduite supervisée</a></li>
                                <li><a href="/post-permis">Post-permis</a></li>
                            </ul>
                        </div>
                        <div class="sidebar-cta-box wow fadeInUp" data-wow-delay="0.25s">
                            <div class="sidebar-cta-header"><div class="icon-box"><img loading="lazy" decoding="async" src="/images/icon-headphone-accent.svg" alt=""></div><div class="sidebar-cta-header-content"><h3>Appelez-nous : <a href="tel:+33438214802">04 38 21 48 02</a></h3></div></div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-8">
                    <div class="course-single-content">
                        <div class="page-single-image"><figure class="image-anime reveal"><picture><source srcset="/images/mc/photo-aac.webp" type="image/webp"><img loading="lazy" decoding="async" src="/images/mc/photo-aac.jpg" alt="Conduite accompagnée (AAC) à Échirolles"></picture></figure></div>

                        <div class="course-entry">
                            <p class="wow fadeInUp">L'apprentissage anticipé de la conduite (AAC), ou conduite accompagnée, est accessible dès 15 ans. Après une formation initiale à l'auto-école (code et 20 heures de conduite minimum), vous conduisez accompagné(e) pendant au moins un an et 3 000 km.</p>
                            <p class="wow fadeInUp" data-wow-delay="0.2s">Résultat : davantage d'expérience, un bien meilleur taux de réussite à l'examen, une période probatoire réduite et, souvent, une assurance « jeune conducteur » plus avantageuse.</p>

                            <div class="course-info-box">
                                <h2 class="text-anime-style-3">Les avantages de la conduite accompagnée</h2>
                                <p class="wow fadeInUp">Une formule qui a fait ses preuves pour aborder l'examen et la route en confiance.</p>
                                <div class="course-info-item-list">
                                    <div class="course-info-item wow fadeInUp" data-wow-delay="0.2s"><div class="icon-box"><img loading="lazy" decoding="async" src="/images/icon-course-info-item-1.svg" alt=""></div><div class="course-info-item-content"><h3>Meilleur taux de réussite</h3><p>Environ 74 % de réussite dès la 1re présentation, contre 55 % en filière traditionnelle.</p></div></div>
                                    <div class="course-info-item wow fadeInUp" data-wow-delay="0.4s"><div class="icon-box"><img loading="lazy" decoding="async" src="/images/icon-course-info-item-2.svg" alt=""></div><div class="course-info-item-content"><h3>Période probatoire réduite</h3><p>2 ans au lieu de 3, avec un examen possible dès 17 ans.</p></div></div>
                                </div>
                                <div class="course-info-images">
                                    <div class="course-info-image"><figure class="image-anime reveal"><picture><source srcset="/images/mc/photo-faq.webp" type="image/webp"><img loading="lazy" decoding="async" src="/images/mc/photo-faq.jpg" alt="Jeune conducteur en conduite accompagnée"></picture></figure></div>
                                    <div class="course-info-image"><figure class="image-anime reveal"><picture><source srcset="/images/mc/photo-exam.webp" type="image/webp"><img loading="lazy" decoding="async" src="/images/mc/photo-exam.jpg" alt="Rendez-vous pédagogique AAC"></picture></figure></div>
                                </div>
                                <p class="wow fadeInUp" data-wow-delay="0.2s">La conduite débute par un rendez-vous préalable et est ponctuée de deux rendez-vous pédagogiques obligatoires, animés par un enseignant, pour faire le point sur vos progrès.</p>
                            </div>

                            <div class="course-types-box">
                                <h2 class="text-anime-style-3">Conditions &amp; accompagnateur</h2>
                                <p class="wow fadeInUp">Quelques conditions à réunir pour démarrer la conduite accompagnée.</p>
                                <div class="course-type-item-list">
                                    <div class="course-type-item">
                                        <div class="course-type-content-box wow fadeInUp"><div class="course-type-item-header"><div class="icon-box"><img loading="lazy" decoding="async" src="/images/icon-course-type-1.svg" alt=""></div><div class="course-type-no"><h3>01</h3></div></div><div class="course-type-item-body"><h3>Pour l'élève (dès 15 ans)</h3><p>Accord du représentant légal et de l'assureur, code réussi, 20 h de conduite minimum et évaluation favorable.</p><ul><li>Attestation de fin de formation initiale requise</li></ul></div></div>
                                        <div class="course-type-image"><figure class="image-anime reveal"><picture><source srcset="/images/mc/photo-aac.webp" type="image/webp"><img loading="lazy" decoding="async" src="/images/mc/photo-aac.jpg" alt="Élève en conduite accompagnée"></picture></figure></div>
                                    </div>
                                    <div class="course-type-item">
                                        <div class="course-type-content-box wow fadeInUp" data-wow-delay="0.2s"><div class="course-type-item-header"><div class="icon-box"><img loading="lazy" decoding="async" src="/images/icon-course-type-2.svg" alt=""></div><div class="course-type-no"><h3>02</h3></div></div><div class="course-type-item-body"><h3>Pour l'accompagnateur</h3><p>Permis B depuis au moins 5 ans sans interruption, accord de l'assureur, mention au contrat.</p><ul><li>Plusieurs accompagnateurs possibles, même hors famille</li></ul></div></div>
                                        <div class="course-type-image"><figure class="image-anime reveal"><picture><source srcset="/images/mc/photo-road.webp" type="image/webp"><img loading="lazy" decoding="async" src="/images/mc/photo-road.jpg" alt="Conduite accompagnée sur route"></picture></figure></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="page-single-faqs">
                            <div class="section-title"><h2 class="text-anime-style-3" data-cursor="-opaque">Questions fréquentes</h2><p class="wow fadeInUp">Les réponses aux questions les plus courantes sur la conduite accompagnée (AAC).</p></div>
                            <div class="faq-accordion" id="accordion">
                                <div class="accordion-item wow fadeInUp"><h2 class="accordion-header" id="heading1"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapse1" aria-expanded="true" aria-controls="collapse1">À partir de quel âge peut-on commencer l'AAC ?</button></h2><div id="collapse1" class="accordion-collapse collapse show" role="region" aria-labelledby="heading1" data-bs-parent="#accordion"><div class="accordion-body"><p>Dès 15 ans, avec l'accord du représentant légal et de l'assureur. Vous pouvez passer l'examen dès 17 ans et, depuis le 1er janvier 2024, conduire seul(e) dès l'obtention du permis.</p></div></div></div>
                                <div class="accordion-item wow fadeInUp" data-wow-delay="0.2s"><h2 class="accordion-header" id="heading2"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse2" aria-expanded="false" aria-controls="collapse2">Combien de temps dure la phase accompagnée ?</button></h2><div id="collapse2" class="accordion-collapse collapse" role="region" aria-labelledby="heading2" data-bs-parent="#accordion"><div class="accordion-body"><p>Au moins un an et 3 000 km, avec deux rendez-vous pédagogiques obligatoires (le premier entre 4 et 6 mois, le second après 3 000 km).</p></div></div></div>
                                <div class="accordion-item wow fadeInUp" data-wow-delay="0.4s"><h2 class="accordion-header" id="heading3"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse3" aria-expanded="false" aria-controls="collapse3">Qui peut être accompagnateur ?</button></h2><div id="collapse3" class="accordion-collapse collapse" role="region" aria-labelledby="heading3" data-bs-parent="#accordion"><div class="accordion-body"><p>Toute personne titulaire du permis B depuis au moins 5 ans sans interruption, avec l'accord de son assureur et mentionnée au contrat. Plusieurs accompagnateurs sont possibles, même hors du cadre familial.</p></div></div></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Page Course Single End -->



    <!-- Avis Google FAB Start -->
    <a class="mc-review-fab" href="https://www.google.com/maps/place/AUTO+ECOLE+MC+CONDUITE/@45.1441566,5.7100222,1331m/data=!3m1!1e3!4m18!1m9!3m8!1s0x478a8b3f6db3fce7:0x4d184686cf363037!2sAUTO+ECOLE+MC+CONDUITE!8m2!3d45.1457321!4d5.7167138!9m1!1b1!16s%2Fg%2F11z21tx4g4!3m7!1s0x478a8b3f6db3fce7:0x4d184686cf363037!8m2!3d45.1457321!4d5.7167138!9m1!1b1!16s%2Fg%2F11z21tx4g4" target="_blank" rel="noopener" aria-label="Laisser un avis sur Google">
        <img loading="lazy" decoding="async" src="/images/icon-google.svg" alt="Google">
        <span class="mc-review-fab-text"><strong>Laissez votre avis</strong><span class="mc-review-fab-stars"><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i></span></span>
    </a>
    <!-- Avis Google FAB End -->
    <!-- Back To Top Start -->
    <a href="#top" class="mc-backtotop" aria-label="Remonter en haut de la page"><i class="fa-solid fa-arrow-up"></i></a>
    <!-- Back To Top End -->

    </main>
</Base>
