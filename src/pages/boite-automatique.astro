---
import Base from '../layouts/Base.astro';

const jsonLd = [
	[
		{
			"@context": "https://schema.org",
			"@type": "BreadcrumbList",
			"itemListElement": [
				{
					"@type": "ListItem",
					"position": 1,
					"name": "Accueil",
					"item": "https://mcconduite.fr/"
				},
				{
					"@type": "ListItem",
					"position": 2,
					"name": "Permis B",
					"item": "https://mcconduite.fr/permis-b"
				},
				{
					"@type": "ListItem",
					"position": 3,
					"name": "Permis B — boîte automatique",
					"item": "https://mcconduite.fr/boite-automatique"
				}
			]
		},
		{
			"@context": "https://schema.org",
			"@type": "FAQPage",
			"mainEntity": [
				{
					"@type": "Question",
					"name": "Qu'est-ce que le permis B78 ?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "C'est le permis obtenu en formation boîte automatique. Il autorise la conduite des véhicules à boîte automatique. La mention 78 figure sur le permis."
					}
				},
				{
					"@type": "Question",
					"name": "Pourrai-je conduire une boîte manuelle plus tard ?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "Oui : une formation complémentaire de 7 heures permet de lever la restriction et de conduire des véhicules à boîte manuelle, sans repasser l'examen."
					}
				},
				{
					"@type": "Question",
					"name": "Quels sont les tarifs ?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "Nos tarifs sont communiqués sur demande. Contactez-nous pour un devis personnalisé et sans engagement."
					}
				}
			]
		}
	]
];
---
<Base
	title={"Permis B boîte automatique (B78) à Échirolles — MC Conduite"}
	description={"Permis B boîte automatique (B78) à Échirolles : une formation souvent plus rapide et sereine, avec passerelle possible vers la boîte manuelle. Tarifs sur demande."}
	keywords={"auto-école Échirolles, permis Grenoble, MC Conduite"}
	path={"/boite-automatique"}
	jsonLd={jsonLd}
>
	<main id="contenu">
	<!-- Header End -->

    <!-- Page Header Section Start -->
    <div class="page-header bg-section dark-section parallaxie">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <!-- Page Header Box Start -->
                    <div class="page-header-box">
                        <h1>Permis B — boîte automatique</h1>
                        <nav>
                            <ol class="breadcrumb"><li class="breadcrumb-item"><a href="/">Accueil</a></li><li class="breadcrumb-item"><a href="/permis-b">Permis B</a></li><li class="breadcrumb-item active" aria-current="page">Permis B — boîte automatique</li></ol>
                        </nav>
                    </div>
                    <!-- Page Header Box End -->
                </div>
            </div>
        </div>
    </div>
    <!-- Page Header Section End -->

<!-- Page Course Single Start -->
    <div class="page-course-single">
        <div class="container">
            <div class="row">
                <div class="col-lg-4">
                    <div class="page-single-sidebar">
                        <div class="page-category-list wow fadeInUp">
                            <h3>Nos formations Permis B</h3>
                            <ul>
                                <li><a href="/code-de-la-route">Code de la route</a></li>
                                <li><a href="/boite-manuelle">Boîte manuelle</a></li>
                                <li><a href="/boite-automatique">Boîte automatique</a></li>
                                <li><a href="/conduite-accompagnee">Conduite accompagnée (AAC)</a></li>
                                <li><a href="/conduite-supervisee">Conduite supervisée</a></li>
                                <li><a href="/post-permis">Post-permis</a></li>
                            </ul>
                        </div>
                        <div class="sidebar-cta-box wow fadeInUp" data-wow-delay="0.25s">
                            <div class="sidebar-cta-header"><div class="icon-box"><img loading="lazy" decoding="async" src="/images/icon-headphone-accent.svg" alt=""></div><div class="sidebar-cta-header-content"><h3>Appelez-nous : <a href="tel:+33438214802">04 38 21 48 02</a></h3></div></div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-8">
                    <div class="course-single-content">
                        <div class="page-single-image"><figure class="image-anime reveal"><picture><source srcset="/images/mc/photo-auto.webp" type="image/webp"><img loading="lazy" decoding="async" src="/images/mc/photo-auto.jpg" alt="Permis B boîte automatique (B78) à Échirolles"></picture></figure></div>

                        <div class="course-entry">
                            <p class="wow fadeInUp">Sans gestion de l'embrayage, le permis B en boîte automatique est souvent plus rapide et plus serein à préparer. Chez MC Conduite, à Échirolles, vous vous concentrez sur la route, l'observation et la sécurité, pour gagner en confiance rapidement.</p>
                            <p class="wow fadeInUp" data-wow-delay="0.2s">Cette formation débouche sur le permis B78, qui autorise la conduite des véhicules à boîte automatique. Une passerelle vers la boîte manuelle reste possible plus tard, grâce à une formation complémentaire de 7 heures, sans repasser l'examen.</p>

                            <div class="course-info-box">
                                <h2 class="text-anime-style-3">Les atouts de la boîte automatique</h2>
                                <p class="wow fadeInUp">Une formation simplifiée, idéale pour aborder l'examen sereinement et obtenir son permis dans de bonnes conditions.</p>
                                <div class="course-info-item-list">
                                    <div class="course-info-item wow fadeInUp" data-wow-delay="0.2s"><div class="icon-box"><img loading="lazy" decoding="async" src="/images/icon-course-info-item-1.svg" alt=""></div><div class="course-info-item-content"><h3>Apprentissage simplifié</h3><p>Pas d'embrayage ni de passage de vitesses : vous vous concentrez sur la conduite.</p></div></div>
                                    <div class="course-info-item wow fadeInUp" data-wow-delay="0.4s"><div class="icon-box"><img loading="lazy" decoding="async" src="/images/icon-course-info-item-2.svg" alt=""></div><div class="course-info-item-content"><h3>Souvent plus rapide</h3><p>Une formation généralement plus courte, pour un permis obtenu plus vite.</p></div></div>
                                </div>
                                <div class="course-info-images">
                                    <div class="course-info-image"><figure class="image-anime reveal"><picture><source srcset="/images/mc/photo-faq.webp" type="image/webp"><img loading="lazy" decoding="async" src="/images/mc/photo-faq.jpg" alt="Élève au volant d'une voiture automatique"></picture></figure></div>
                                    <div class="course-info-image"><figure class="image-anime reveal"><picture><source srcset="/images/mc/interieur-2.webp" type="image/webp"><img loading="lazy" decoding="async" src="/images/mc/interieur-2.jpg" alt="Agence MC Conduite"></picture></figure></div>
                                </div>
                                <p class="wow fadeInUp" data-wow-delay="0.2s">Une passerelle de 7 heures permet ensuite de passer en boîte manuelle sans repasser l'examen, si vous le souhaitez.</p>
                            </div>

                            <div class="course-types-box">
                                <h2 class="text-anime-style-3">À qui s'adresse cette formation</h2>
                                <p class="wow fadeInUp">Le permis B78 est particulièrement adapté à plusieurs profils de conducteurs.</p>
                                <div class="course-type-item-list">
                                    <div class="course-type-item">
                                        <div class="course-type-content-box wow fadeInUp"><div class="course-type-item-header"><div class="icon-box"><img loading="lazy" decoding="async" src="/images/icon-course-type-1.svg" alt=""></div><div class="course-type-no"><h3>01</h3></div></div><div class="course-type-item-body"><h3>Conducteurs pressés ou anxieux</h3><p>Pour obtenir son permis rapidement et aborder la conduite sereinement.</p><ul><li>Formation simplifiée et rassurante</li></ul></div></div>
                                        <div class="course-type-image"><figure class="image-anime reveal"><picture><source srcset="/images/mc/photo-auto.webp" type="image/webp"><img loading="lazy" decoding="async" src="/images/mc/photo-auto.jpg" alt="Conduite en boîte automatique"></picture></figure></div>
                                    </div>
                                    <div class="course-type-item">
                                        <div class="course-type-content-box wow fadeInUp" data-wow-delay="0.2s"><div class="course-type-item-header"><div class="icon-box"><img loading="lazy" decoding="async" src="/images/icon-course-type-2.svg" alt=""></div><div class="course-type-no"><h3>02</h3></div></div><div class="course-type-item-body"><h3>Conduite quotidienne en ville</h3><p>De plus en plus de véhicules récents et électriques sont automatiques.</p><ul><li>Permis adapté aux usages d'aujourd'hui</li></ul></div></div>
                                        <div class="course-type-image"><figure class="image-anime reveal"><picture><source srcset="/images/mc/devanture.webp" type="image/webp"><img loading="lazy" decoding="async" src="/images/mc/devanture.jpg" alt="MC Conduite à Échirolles"></picture></figure></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="page-single-faqs">
                            <div class="section-title"><h2 class="text-anime-style-3" data-cursor="-opaque">Questions fréquentes</h2><p class="wow fadeInUp">Les réponses aux questions les plus courantes sur le permis B boîte automatique.</p></div>
                            <div class="faq-accordion" id="accordion">
                                <div class="accordion-item wow fadeInUp"><h2 class="accordion-header" id="heading1"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapse1" aria-expanded="true" aria-controls="collapse1">Qu'est-ce que le permis B78 ?</button></h2><div id="collapse1" class="accordion-collapse collapse show" role="region" aria-labelledby="heading1" data-bs-parent="#accordion"><div class="accordion-body"><p>C'est le permis obtenu en formation boîte automatique. Il autorise la conduite des véhicules à boîte automatique. La mention 78 figure sur le permis.</p></div></div></div>
                                <div class="accordion-item wow fadeInUp" data-wow-delay="0.2s"><h2 class="accordion-header" id="heading2"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse2" aria-expanded="false" aria-controls="collapse2">Pourrai-je conduire une boîte manuelle plus tard ?</button></h2><div id="collapse2" class="accordion-collapse collapse" role="region" aria-labelledby="heading2" data-bs-parent="#accordion"><div class="accordion-body"><p>Oui : une formation complémentaire de 7 heures permet de lever la restriction et de conduire des véhicules à boîte manuelle, sans repasser l'examen.</p></div></div></div>
                                <div class="accordion-item wow fadeInUp" data-wow-delay="0.4s"><h2 class="accordion-header" id="heading3"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse3" aria-expanded="false" aria-controls="collapse3">Quels sont les tarifs ?</button></h2><div id="collapse3" class="accordion-collapse collapse" role="region" aria-labelledby="heading3" data-bs-parent="#accordion"><div class="accordion-body"><p>Nos tarifs sont communiqués sur demande. Contactez-nous pour un devis personnalisé et sans engagement.</p></div></div></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Page Course Single End -->



    <!-- Avis Google FAB Start -->
    <a class="mc-review-fab" href="https://www.google.com/maps/place/AUTO+ECOLE+MC+CONDUITE/@45.1441566,5.7100222,1331m/data=!3m1!1e3!4m18!1m9!3m8!1s0x478a8b3f6db3fce7:0x4d184686cf363037!2sAUTO+ECOLE+MC+CONDUITE!8m2!3d45.1457321!4d5.7167138!9m1!1b1!16s%2Fg%2F11z21tx4g4!3m7!1s0x478a8b3f6db3fce7:0x4d184686cf363037!8m2!3d45.1457321!4d5.7167138!9m1!1b1!16s%2Fg%2F11z21tx4g4" target="_blank" rel="noopener" aria-label="Laisser un avis sur Google">
        <img loading="lazy" decoding="async" src="/images/icon-google.svg" alt="Google">
        <span class="mc-review-fab-text"><strong>Laissez votre avis</strong><span class="mc-review-fab-stars"><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i></span></span>
    </a>
    <!-- Avis Google FAB End -->
    <!-- Back To Top Start -->
    <a href="#top" class="mc-backtotop" aria-label="Remonter en haut de la page"><i class="fa-solid fa-arrow-up"></i></a>
    <!-- Back To Top End -->

    </main>
</Base>
