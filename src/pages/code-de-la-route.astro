---
import Base from '../layouts/Base.astro';

const jsonLd = [
	[
		{
			"@context": "https://schema.org",
			"@type": "BreadcrumbList",
			"itemListElement": [
				{
					"@type": "ListItem",
					"position": 1,
					"name": "Accueil",
					"item": "https://mcconduite.fr/"
				},
				{
					"@type": "ListItem",
					"position": 2,
					"name": "Permis B",
					"item": "https://mcconduite.fr/permis-b"
				},
				{
					"@type": "ListItem",
					"position": 3,
					"name": "Code de la route",
					"item": "https://mcconduite.fr/code-de-la-route"
				}
			]
		},
		{
			"@context": "https://schema.org",
			"@type": "FAQPage",
			"mainEntity": [
				{
					"@type": "Question",
					"name": "Comment se prépare le code chez MC Conduite ?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "Vous combinez des séances en salle avec un formateur et un entraînement en ligne en accès illimité. Vous progressez à votre rythme sur toutes les thématiques de l'examen, jusqu'à être prêt(e)."
					}
				},
				{
					"@type": "Question",
					"name": "Faut-il avoir le code avant de commencer la conduite ?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "La réussite du code est nécessaire pour passer l'épreuve pratique. Vous pouvez toutefois débuter votre formation et préparer le code et la conduite en parallèle."
					}
				},
				{
					"@type": "Question",
					"name": "Combien coûte la préparation au code ?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "Nos tarifs sont communiqués sur demande, selon la formule choisie. Contactez-nous pour un devis personnalisé et sans engagement."
					}
				}
			]
		}
	]
];
---
<Base
	title={"Code de la route à Échirolles — MC Conduite"}
	description={"Préparez le code de la route avec MC Conduite à Échirolles : cours en salle et entraînement en ligne illimité jusqu'à la réussite. Tarifs sur demande."}
	keywords={"auto-école Échirolles, permis Grenoble, MC Conduite"}
	path={"/code-de-la-route"}
	jsonLd={jsonLd}
>
	<main id="contenu">
	<!-- Header End -->

    <!-- Page Header Section Start -->
    <div class="page-header bg-section dark-section parallaxie">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <!-- Page Header Box Start -->
                    <div class="page-header-box">
                        <h1>Code de la route à Échirolles</h1>
                        <nav>
                            <ol class="breadcrumb"><li class="breadcrumb-item"><a href="/">Accueil</a></li><li class="breadcrumb-item"><a href="/permis-b">Permis B</a></li><li class="breadcrumb-item active" aria-current="page">Code de la route</li></ol>
                        </nav>
                    </div>
                    <!-- Page Header Box End -->
                </div>
            </div>
        </div>
    </div>
    <!-- Page Header Section End -->

<!-- Page Course Single Start -->
    <div class="page-course-single">
        <div class="container">
            <div class="row">
                <div class="col-lg-4">
                    <!-- Sidebar -->
                    <div class="page-single-sidebar">
                        <div class="page-category-list wow fadeInUp">
                            <h3>Nos formations Permis B</h3>
                            <ul>
                                <li><a href="/code-de-la-route">Code de la route</a></li>
                                <li><a href="/boite-manuelle">Boîte manuelle</a></li>
                                <li><a href="/boite-automatique">Boîte automatique</a></li>
                                <li><a href="/conduite-accompagnee">Conduite accompagnée (AAC)</a></li>
                                <li><a href="/conduite-supervisee">Conduite supervisée</a></li>
                                <li><a href="/post-permis">Post-permis</a></li>
                            </ul>
                        </div>
                        <div class="sidebar-cta-box wow fadeInUp" data-wow-delay="0.25s">
                            <div class="sidebar-cta-header">
                                <div class="icon-box"><img loading="lazy" decoding="async" src="/images/icon-headphone-accent.svg" alt=""></div>
                                <div class="sidebar-cta-header-content">
                                    <h3>Appelez-nous : <a href="tel:+33438214802">04 38 21 48 02</a></h3>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-8">
                    <div class="course-single-content">
                        <div class="page-single-image">
                            <figure class="image-anime reveal"><picture><source srcset="/images/mc/photo-code.webp" type="image/webp"><img loading="lazy" decoding="async" src="/images/mc/photo-code.jpg" alt="Préparation au code de la route à Échirolles"></picture></figure>
                        </div>

                        <div class="course-entry">
                            <p class="wow fadeInUp">Le code de la route est la première étape vers le permis B. Chez MC Conduite, à Échirolles, vous préparez l'épreuve théorique générale (ETG) à votre rythme : en salle avec un formateur et en ligne, en accès illimité jusqu'à la réussite.</p>
                            <p class="wow fadeInUp" data-wow-delay="0.2s">L'examen du code valide vos connaissances des règles de circulation, de la signalisation, de la sécurité, des premiers secours et du comportement responsable au volant. Nous vous accompagnons sur l'ensemble de ces thématiques et nous gérons votre inscription à l'examen.</p>

                            <div class="course-info-box">
                                <h2 class="text-anime-style-3">Pourquoi préparer son code chez MC Conduite</h2>
                                <p class="wow fadeInUp">Une préparation complète et flexible, pensée pour vous faire réussir rapidement, avec un suivi personnalisé de votre progression.</p>
                                <div class="course-info-item-list">
                                    <div class="course-info-item wow fadeInUp" data-wow-delay="0.2s">
                                        <div class="icon-box"><img loading="lazy" decoding="async" src="/images/icon-course-info-item-1.svg" alt=""></div>
                                        <div class="course-info-item-content">
                                            <h3>Salle &amp; en ligne illimité</h3>
                                            <p>Des cours en salle avec un formateur et un accès en ligne illimité, jusqu'à la réussite.</p>
                                        </div>
                                    </div>
                                    <div class="course-info-item wow fadeInUp" data-wow-delay="0.4s">
                                        <div class="icon-box"><img loading="lazy" decoding="async" src="/images/icon-course-info-item-2.svg" alt=""></div>
                                        <div class="course-info-item-content">
                                            <h3>Suivi personnalisé</h3>
                                            <p>Un suivi de votre progression et des conseils ciblés sur vos points à travailler.</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="course-info-images">
                                    <div class="course-info-image"><figure class="image-anime reveal"><picture><source srcset="/images/mc/interieur-1.webp" type="image/webp"><img loading="lazy" decoding="async" src="/images/mc/interieur-1.jpg" alt="Salle de formation MC Conduite"></picture></figure></div>
                                    <div class="course-info-image"><figure class="image-anime reveal"><picture><source srcset="/images/mc/interieur-2.webp" type="image/webp"><img loading="lazy" decoding="async" src="/images/mc/interieur-2.jpg" alt="Accueil de l'auto-école MC Conduite"></picture></figure></div>
                                </div>
                                <p class="wow fadeInUp" data-wow-delay="0.2s">Vous abordez ainsi l'examen en confiance, avec toutes les clés pour réussir du premier coup et, surtout, pour devenir un conducteur prudent et responsable.</p>
                            </div>

                            <div class="course-types-box">
                                <h2 class="text-anime-style-3">À qui s'adresse cette formation</h2>
                                <p class="wow fadeInUp">La formation au code s'adresse à tous les futurs conducteurs, quel que soit leur projet de permis.</p>
                                <div class="course-type-item-list">
                                    <div class="course-type-item">
                                        <div class="course-type-content-box wow fadeInUp">
                                            <div class="course-type-item-header">
                                                <div class="icon-box"><img loading="lazy" decoding="async" src="/images/icon-course-type-1.svg" alt=""></div>
                                                <div class="course-type-no"><h3>01</h3></div>
                                            </div>
                                            <div class="course-type-item-body">
                                                <h3>Débutants &amp; conduite accompagnée</h3>
                                                <p>Première étape avant la conduite, y compris pour l'AAC dès 15 ans.</p>
                                                <ul><li>Accessible dès le début de votre formation</li></ul>
                                            </div>
                                        </div>
                                        <div class="course-type-image"><figure class="image-anime reveal"><picture><source srcset="/images/mc/photo-permis-b.webp" type="image/webp"><img loading="lazy" decoding="async" src="/images/mc/photo-permis-b.jpg" alt="Élève en formation au code"></picture></figure></div>
                                    </div>
                                    <div class="course-type-item">
                                        <div class="course-type-content-box wow fadeInUp" data-wow-delay="0.2s">
                                            <div class="course-type-item-header">
                                                <div class="icon-box"><img loading="lazy" decoding="async" src="/images/icon-course-type-2.svg" alt=""></div>
                                                <div class="course-type-no"><h3>02</h3></div>
                                            </div>
                                            <div class="course-type-item-body">
                                                <h3>Candidats au permis B ou moto</h3>
                                                <p>La réussite du code est nécessaire avant l'épreuve pratique.</p>
                                                <ul><li>Préparation à l'ETG (code voiture)</li></ul>
                                            </div>
                                        </div>
                                        <div class="course-type-image"><figure class="image-anime reveal"><picture><source srcset="/images/mc/photo-faq.webp" type="image/webp"><img loading="lazy" decoding="async" src="/images/mc/photo-faq.jpg" alt="Candidat au permis"></picture></figure></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="page-single-faqs">
                            <div class="section-title">
                                <h2 class="text-anime-style-3" data-cursor="-opaque">Questions fréquentes</h2>
                                <p class="wow fadeInUp">Les réponses aux questions les plus courantes sur la préparation et le passage du code de la route.</p>
                            </div>
                            <div class="faq-accordion" id="accordion">
                                <div class="accordion-item wow fadeInUp">
                                    <h2 class="accordion-header" id="heading1"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapse1" aria-expanded="true" aria-controls="collapse1">Comment se prépare le code chez MC Conduite ?</button></h2>
                                    <div id="collapse1" class="accordion-collapse collapse show" role="region" aria-labelledby="heading1" data-bs-parent="#accordion"><div class="accordion-body"><p>Vous combinez des séances en salle avec un formateur et un entraînement en ligne en accès illimité. Vous progressez à votre rythme sur toutes les thématiques de l'examen, jusqu'à être prêt(e).</p></div></div>
                                </div>
                                <div class="accordion-item wow fadeInUp" data-wow-delay="0.2s">
                                    <h2 class="accordion-header" id="heading2"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse2" aria-expanded="false" aria-controls="collapse2">Faut-il avoir le code avant de commencer la conduite ?</button></h2>
                                    <div id="collapse2" class="accordion-collapse collapse" role="region" aria-labelledby="heading2" data-bs-parent="#accordion"><div class="accordion-body"><p>La réussite du code est nécessaire pour passer l'épreuve pratique. Vous pouvez toutefois débuter votre formation et préparer le code et la conduite en parallèle.</p></div></div>
                                </div>
                                <div class="accordion-item wow fadeInUp" data-wow-delay="0.4s">
                                    <h2 class="accordion-header" id="heading3"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse3" aria-expanded="false" aria-controls="collapse3">Combien coûte la préparation au code ?</button></h2>
                                    <div id="collapse3" class="accordion-collapse collapse" role="region" aria-labelledby="heading3" data-bs-parent="#accordion"><div class="accordion-body"><p>Nos tarifs sont communiqués sur demande, selon la formule choisie. Contactez-nous pour un devis personnalisé et sans engagement.</p></div></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Page Course Single End -->



    <!-- Avis Google FAB Start -->
    <a class="mc-review-fab" href="https://www.google.com/maps/place/AUTO+ECOLE+MC+CONDUITE/@45.1441566,5.7100222,1331m/data=!3m1!1e3!4m18!1m9!3m8!1s0x478a8b3f6db3fce7:0x4d184686cf363037!2sAUTO+ECOLE+MC+CONDUITE!8m2!3d45.1457321!4d5.7167138!9m1!1b1!16s%2Fg%2F11z21tx4g4!3m7!1s0x478a8b3f6db3fce7:0x4d184686cf363037!8m2!3d45.1457321!4d5.7167138!9m1!1b1!16s%2Fg%2F11z21tx4g4" target="_blank" rel="noopener" aria-label="Laisser un avis sur Google">
        <img loading="lazy" decoding="async" src="/images/icon-google.svg" alt="Google">
        <span class="mc-review-fab-text"><strong>Laissez votre avis</strong><span class="mc-review-fab-stars"><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i></span></span>
    </a>
    <!-- Avis Google FAB End -->
    <!-- Back To Top Start -->
    <a href="#top" class="mc-backtotop" aria-label="Remonter en haut de la page"><i class="fa-solid fa-arrow-up"></i></a>
    <!-- Back To Top End -->

    </main>
</Base>
