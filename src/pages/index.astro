		"logo": "https://mcconduite.fr/images/mc/logo-mc-conduite.png",
		"description": "Auto-moto-école labellisée à Échirolles : permis B (boîte manuelle et automatique), conduite accompagnée, code de la route et permis moto.",
		"priceRange": "€€",
		"address": {
			"@type": "PostalAddress",
			"streetAddress": "26 avenue du 8 mai 1945",
			"postalCode": "38130",
			"addressLocality": "Échirolles",
			"addressRegion": "Isère",
			"addressCountry": "FR"
		},
		"geo": {
			"@type": "GeoCoordinates",
			"latitude": 45.1457321,
			"longitude": 5.7167138
		},
		"hasMap": "https://www.google.com/maps/place/AUTO+ECOLE+MC+CONDUITE/@45.1457321,5.7167138,17z",
		"telephone": "+33438214802",
		"email": "mcconduiteechirolles@gmail.com",
		"areaServed": [
			"Échirolles",
			"Grenoble",
			"Eybens",
			"Le Pont-de-Claix",
			"Seyssins",
			"Seyssinet-Pariset"
		],
		"openingHoursSpecification": [
			{
				"@type": "OpeningHoursSpecification",
				"dayOfWeek": [
					"Monday",
					"Tuesday",
					"Wednesday",
					"Thursday",
					"Friday"
				],
				"opens": "09:00",
				"closes": "12:00"
			},
			{
				"@type": "OpeningHoursSpecification",
				"dayOfWeek": [
					"Monday",
					"Tuesday",
					"Wednesday",
					"Thursday",
					"Friday"
				],
				"opens": "14:00",
				"closes": "18:00"
			},
			{
				"@type": "OpeningHoursSpecification",
				"dayOfWeek": "Saturday",
				"opens": "10:00",
				"closes": "14:00"
			}
		],
		"sameAs": [
			"https://www.instagram.com/mcconduite38130",
			"https://www.tiktok.com/@mcconduite38130"
		]
	},
	[
		{
			"@context": "https://schema.org",
			"@type": "FAQPage",
			"mainEntity": [
				{
					"@type": "Question",
					"name": "Quelles formations proposez-vous ?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "MC Conduite propose le permis B en boîte manuelle et automatique, la conduite accompagnée (AAC) et supervisée, le stage post-permis, la formation au code de la route, ainsi que les permis moto (AM, A1, A2 et A L5e). Nous vous orientons vers la formule la plus adaptée à votre projet."
					}
				},
				{
					"@type": "Question",
					"name": "Proposez-vous la conduite accompagnée (AAC) ?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "Oui. La conduite accompagnée est accessible dès 15 ans : après une formation initiale, vous conduisez accompagné(e) pendant au moins 1 an (3 000 km minimum) avec des rendez-vous pédagogiques. C'est un vrai plus pour la réussite, l'assurance et la réduction de la période probatoire."
					}
				},
				{
					"@type": "Question",
					"name": "Faut-il déjà avoir le code pour s'inscrire ?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "Non. La préparation au code de la route fait partie de nos formations : entraînement en salle et en ligne, en accès illimité jusqu'à l'obtention. Si vous avez déjà votre code en cours de validité, nous adaptons votre parcours en conséquence."
					}
				},
				{
					"@type": "Question",
					"name": "Où se déroule la formation moto ?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "Les exercices de plateau se déroulent sur notre piste d'entraînement, sur le parking d'Alpexpo (2 avenue d'Innsbruck, 38100 Grenoble), à 5 à 10 minutes de l'agence. Les sessions se font en petit effectif (6 participants maximum) pour un meilleur suivi."
					}
				},
				{
					"@type": "Question",
					"name": "Comment s'inscrire à MC Conduite ?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "Le plus simple est de remplir le formulaire de pré-inscription en ligne : nous vous recontactons pour faire le point sur votre projet et finaliser votre dossier. Vous pouvez aussi passer directement à l'agence, au 26 avenue du 8 mai 1945 à Échirolles, ou nous appeler au 04 38 21 48 02."
					}
				},
				{
					"@type": "Question",
					"name": "Comment choisir son auto-école à Échirolles ?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "Pour bien choisir votre auto-école à Échirolles, appuyez-vous sur des critères concrets : la transparence des tarifs (prix affichés clairement, sans frais cachés), les avis récents des élèves, la qualité du suivi pédagogique et la diversité des formations. Chez MC Conduite, tous les tarifs sont publiés en ligne, la note Google est de 4,8/5, et nous proposons le permis B (boîte manuelle et automatique), la conduite accompagnée, le code de la route et le permis moto, avec un accompagnement personnalisé du premier contact jusqu'à l'obtention."
					}
				}
			]
		}
	]
];
