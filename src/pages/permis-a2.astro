---
import Base from '../layouts/Base.astro';

const jsonLd = [
	[
		{
			"@context": "https://schema.org",
			"@type": "BreadcrumbList",
			"itemListElement": [
				{
					"@type": "ListItem",
					"position": 1,
					"name": "Accueil",
					"item": "https://mcconduite.fr/"
				},
				{
					"@type": "ListItem",
					"position": 2,
					"name": "Permis Moto",
					"item": "https://mcconduite.fr/permis-moto"
				},
				{
					"@type": "ListItem",
					"position": 3,
					"name": "Permis A2",
					"item": "https://mcconduite.fr/permis-a2"
				}
			]
		},
		{
			"@context": "https://schema.org",
			"@type": "FAQPage",
			"mainEntity": [
				{
					"@type": "Question",
					"name": "Quelles motos avec le permis A2 ?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "Les motos d'une puissance limitée à 35 kW, dès 18 ans."
					}
				},
				{
					"@type": "Question",
					"name": "Comment passer au permis A ?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "Après 2 ans de permis A2 et une formation passerelle de 7 heures, vous accédez au permis A (toutes cylindrées), sans repasser l'examen."
					}
				},
				{
					"@type": "Question",
					"name": "Où se déroule le plateau ?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "Sur notre piste d'entraînement dédiée, au parking d'Alpexpo à Grenoble, à 5 à 10 minutes de l'agence, en petit effectif (6 participants maximum)."
					}
				}
			]
		}
	]
];
---
<Base
	title={"Permis A2 (moto) à Grenoble — MC Conduite Échirolles"}
	description={"Permis A2 dès 18 ans avec MC Conduite : motos jusqu'à 35 kW, plateau et circulation, passerelle vers le permis A après 2 ans. Tarifs sur demande."}
	keywords={"auto-école Échirolles, permis Grenoble, MC Conduite"}
	path={"/permis-a2"}
	jsonLd={jsonLd}
>
	<main id="contenu">
	<!-- Header End -->

    <!-- Page Header Section Start -->
    <div class="page-header bg-section dark-section parallaxie">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <!-- Page Header Box Start -->
                    <div class="page-header-box">
                        <h1>Permis A2</h1>
                        <nav>
                            <ol class="breadcrumb"><li class="breadcrumb-item"><a href="/">Accueil</a></li><li class="breadcrumb-item"><a href="/permis-moto">Permis Moto</a></li><li class="breadcrumb-item active" aria-current="page">Permis A2</li></ol>
                        </nav>
                    </div>
                    <!-- Page Header Box End -->
                </div>
            </div>
        </div>
    </div>
    <!-- Page Header Section End -->

<!-- Page Course Single Start -->
    <div class="page-course-single">
        <div class="container">
            <div class="row">
                <div class="col-lg-4">
                    <div class="page-single-sidebar">
                        <div class="page-category-list wow fadeInUp">
                            <h3>Nos formations Moto</h3>
                            <ul>
                                <li><a href="/code-moto">Code moto (ETM)</a></li>
                                <li><a href="/permis-am">Permis AM</a></li>
                                <li><a href="/permis-a1">Permis A1</a></li>
                                <li><a href="/permis-a2">Permis A2</a></li>
                                <li><a href="/permis-a-l5e">Permis A L5e</a></li>
                            </ul>
                        </div>
                        <div class="sidebar-cta-box wow fadeInUp" data-wow-delay="0.25s">
                            <div class="sidebar-cta-header"><div class="icon-box"><img loading="lazy" decoding="async" src="/images/icon-headphone-accent.svg" alt=""></div><div class="sidebar-cta-header-content"><h3>Appelez-nous : <a href="tel:+33438214802">04 38 21 48 02</a></h3></div></div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-8">
                    <div class="course-single-content">
                        <div class="page-single-image"><figure class="image-anime reveal"><picture><source srcset="/images/mc/photo-road.webp" type="image/webp"><img loading="lazy" decoding="async" src="/images/mc/photo-road.jpg" alt="Permis A2 (moto) à Grenoble"></picture></figure></div>

                        <div class="course-entry">
                            <p class="wow fadeInUp">Accessible dès 18 ans, le permis A2 autorise les motos d'une puissance limitée à 35 kW. C'est la véritable porte d'entrée vers la moto : après 2 ans de A2 et une formation passerelle de 7 heures, vous accédez au permis A (toutes cylindrées).</p>
                            <p class="wow fadeInUp" data-wow-delay="0.2s">La formation comprend le code moto, l'épreuve de plateau et l'épreuve de circulation. Les exercices de plateau se déroulent sur notre piste dédiée, au parking d'Alpexpo à Grenoble, en petit effectif.</p>

                            <div class="course-info-box">
                                <h2 class="text-anime-style-3">L'essentiel du permis A2</h2>
                                <p class="wow fadeInUp">Une formation complète, avec une perspective d'évolution vers le permis A.</p>
                                <div class="course-info-item-list">
                                    <div class="course-info-item wow fadeInUp" data-wow-delay="0.2s"><div class="icon-box"><img loading="lazy" decoding="async" src="/images/icon-course-info-item-1.svg" alt=""></div><div class="course-info-item-content"><h3>Dès 18 ans</h3><p>Motos limitées à 35 kW.</p></div></div>
                                    <div class="course-info-item wow fadeInUp" data-wow-delay="0.4s"><div class="icon-box"><img loading="lazy" decoding="async" src="/images/icon-course-info-item-2.svg" alt=""></div><div class="course-info-item-content"><h3>Passerelle vers le permis A</h3><p>Après 2 ans et une formation de 7 h, accès à toutes les cylindrées.</p></div></div>
                                </div>
                                <div class="course-info-images">
                                    <div class="course-info-image"><figure class="image-anime reveal"><picture><source srcset="/images/mc/header-bg.webp" type="image/webp"><img loading="lazy" decoding="async" src="/images/mc/header-bg.jpg" alt="Route de montagne"></picture></figure></div>
                                    <div class="course-info-image"><figure class="image-anime reveal"><picture><source srcset="/images/mc/devanture.webp" type="image/webp"><img loading="lazy" decoding="async" src="/images/mc/devanture.jpg" alt="MC Conduite à Échirolles"></picture></figure></div>
                                </div>
                                <p class="wow fadeInUp" data-wow-delay="0.2s">La formation comprend 8 leçons de plateau et 12 leçons de circulation. Tarif : 890 € tout compris, code moto offert avec le forfait — voir la page <a href="/tarifs">Tarifs</a>.</p>
                            </div>

                            <div class="course-types-box">
                                <h2 class="text-anime-style-3">À qui s'adresse le permis A2</h2>
                                <p class="wow fadeInUp">Pour tous ceux qui veulent rouler en moto et évoluer ensuite vers le permis A.</p>
                                <div class="course-type-item-list">
                                    <div class="course-type-item">
                                        <div class="course-type-content-box wow fadeInUp"><div class="course-type-item-header"><div class="icon-box"><img loading="lazy" decoding="async" src="/images/icon-course-type-1.svg" alt=""></div><div class="course-type-no"><h3>01</h3></div></div><div class="course-type-item-body"><h3>Conducteurs dès 18 ans</h3><p>Pour accéder à la moto avec une puissance encadrée.</p><ul><li>Motos jusqu'à 35 kW</li></ul></div></div>
                                        <div class="course-type-image"><figure class="image-anime reveal"><picture><source srcset="/images/mc/photo-road.webp" type="image/webp"><img loading="lazy" decoding="async" src="/images/mc/photo-road.jpg" alt="Conduite moto"></picture></figure></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="page-single-faqs">
                            <div class="section-title"><h2 class="text-anime-style-3" data-cursor="-opaque">Questions fréquentes</h2><p class="wow fadeInUp">Les réponses aux questions les plus courantes sur le permis A2.</p></div>
                            <div class="faq-accordion" id="accordion">
                                <div class="accordion-item wow fadeInUp"><h2 class="accordion-header" id="heading1"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapse1" aria-expanded="true" aria-controls="collapse1">Quelles motos avec le permis A2 ?</button></h2><div id="collapse1" class="accordion-collapse collapse show" role="region" aria-labelledby="heading1" data-bs-parent="#accordion"><div class="accordion-body"><p>Les motos d'une puissance limitée à 35 kW, dès 18 ans.</p></div></div></div>
                                <div class="accordion-item wow fadeInUp" data-wow-delay="0.2s"><h2 class="accordion-header" id="heading2"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse2" aria-expanded="false" aria-controls="collapse2">Comment passer au permis A ?</button></h2><div id="collapse2" class="accordion-collapse collapse" role="region" aria-labelledby="heading2" data-bs-parent="#accordion"><div class="accordion-body"><p>Après 2 ans de permis A2 et une formation passerelle de 7 heures, vous accédez au permis A (toutes cylindrées), sans repasser l'examen.</p></div></div></div>
                                <div class="accordion-item wow fadeInUp" data-wow-delay="0.4s"><h2 class="accordion-header" id="heading3"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse3" aria-expanded="false" aria-controls="collapse3">Où se déroule le plateau ?</button></h2><div id="collapse3" class="accordion-collapse collapse" role="region" aria-labelledby="heading3" data-bs-parent="#accordion"><div class="accordion-body"><p>Sur notre piste d'entraînement dédiée, au parking d'Alpexpo à Grenoble, à 5 à 10 minutes de l'agence, en petit effectif (6 participants maximum).</p></div></div></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Page Course Single End -->



    <!-- Avis Google FAB Start -->
    <a class="mc-review-fab" href="https://www.google.com/maps/place/AUTO+ECOLE+MC+CONDUITE/@45.1441566,5.7100222,1331m/data=!3m1!1e3!4m18!1m9!3m8!1s0x478a8b3f6db3fce7:0x4d184686cf363037!2sAUTO+ECOLE+MC+CONDUITE!8m2!3d45.1457321!4d5.7167138!9m1!1b1!16s%2Fg%2F11z21tx4g4!3m7!1s0x478a8b3f6db3fce7:0x4d184686cf363037!8m2!3d45.1457321!4d5.7167138!9m1!1b1!16s%2Fg%2F11z21tx4g4" target="_blank" rel="noopener" aria-label="Laisser un avis sur Google">
        <img loading="lazy" decoding="async" src="/images/icon-google.svg" alt="Google">
        <span class="mc-review-fab-text"><strong>Laissez votre avis</strong><span class="mc-review-fab-stars"><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i></span></span>
    </a>
    <!-- Avis Google FAB End -->
    <!-- Back To Top Start -->
    <a href="#top" class="mc-backtotop" aria-label="Remonter en haut de la page"><i class="fa-solid fa-arrow-up"></i></a>
    <!-- Back To Top End -->

    </main>
</Base>
