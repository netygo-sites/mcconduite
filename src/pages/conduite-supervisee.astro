---
import Base from '../layouts/Base.astro';

const jsonLd = [
	[
		{
			"@context": "https://schema.org",
			"@type": "BreadcrumbList",
			"itemListElement": [
				{
					"@type": "ListItem",
					"position": 1,
					"name": "Accueil",
					"item": "https://mcconduite.fr/"
				},
				{
					"@type": "ListItem",
					"position": 2,
					"name": "Permis B",
					"item": "https://mcconduite.fr/permis-b"
				},
				{
					"@type": "ListItem",
					"position": 3,
					"name": "Conduite supervisée",
					"item": "https://mcconduite.fr/conduite-supervisee"
				}
			]
		},
		{
			"@context": "https://schema.org",
			"@type": "FAQPage",
			"mainEntity": [
				{
					"@type": "Question",
					"name": "Quelle différence avec la conduite accompagnée ?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "La conduite supervisée est accessible dès 18 ans et n'impose pas de durée ni de kilométrage minimum. Contrairement à l'AAC, la période probatoire reste de 3 ans."
					}
				},
				{
					"@type": "Question",
					"name": "Peut-on y passer après un échec à l'examen ?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "Oui. Avec l'accord écrit de l'assurance et une autorisation de conduire en supervisée, vous pouvez progresser avant de repasser l'épreuve pratique."
					}
				},
				{
					"@type": "Question",
					"name": "Qui peut être accompagnateur ?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "Toute personne titulaire du permis B depuis au moins 5 ans sans interruption, avec l'accord de son assureur et mentionnée au contrat."
					}
				}
			]
		}
	]
];
---
<Base
	title={"Conduite supervisée à Échirolles — MC Conduite"}
	description={"Conduite supervisée dès 18 ans à Échirolles : acquérir de l'expérience avant l'examen ou après un échec. Conditions, avantages et déroulé. Tarifs sur demande."}
	keywords={"auto-école Échirolles, permis Grenoble, MC Conduite"}
	path={"/conduite-supervisee"}
	jsonLd={jsonLd}
>
	<main id="contenu">
	<!-- Header End -->

    <!-- Page Header Section Start -->
    <div class="page-header bg-section dark-section parallaxie">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <!-- Page Header Box Start -->
                    <div class="page-header-box">
                        <h1>Conduite supervisée</h1>
                        <nav>
                            <ol class="breadcrumb"><li class="breadcrumb-item"><a href="/">Accueil</a></li><li class="breadcrumb-item"><a href="/permis-b">Permis B</a></li><li class="breadcrumb-item active" aria-current="page">Conduite supervisée</li></ol>
                        </nav>
                    </div>
                    <!-- Page Header Box End -->
                </div>
            </div>
        </div>
    </div>
    <!-- Page Header Section End -->

<!-- Page Course Single Start -->
    <div class="page-course-single">
        <div class="container">
            <div class="row">
                <div class="col-lg-4">
                    <div class="page-single-sidebar">
                        <div class="page-category-list wow fadeInUp">
                            <h3>Nos formations Permis B</h3>
                            <ul>
                                <li><a href="/code-de-la-route">Code de la route</a></li>
                                <li><a href="/boite-manuelle">Boîte manuelle</a></li>
                                <li><a href="/boite-automatique">Boîte automatique</a></li>
                                <li><a href="/conduite-accompagnee">Conduite accompagnée (AAC)</a></li>
                                <li><a href="/conduite-supervisee">Conduite supervisée</a></li>
                                <li><a href="/post-permis">Post-permis</a></li>
                            </ul>
                        </div>
                        <div class="sidebar-cta-box wow fadeInUp" data-wow-delay="0.25s">
                            <div class="sidebar-cta-header"><div class="icon-box"><img loading="lazy" decoding="async" src="/images/icon-headphone-accent.svg" alt=""></div><div class="sidebar-cta-header-content"><h3>Appelez-nous : <a href="tel:+33438214802">04 38 21 48 02</a></h3></div></div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-8">
                    <div class="course-single-content">
                        <div class="page-single-image"><figure class="image-anime reveal"><picture><source srcset="/images/mc/photo-exam.webp" type="image/webp"><img loading="lazy" decoding="async" src="/images/mc/photo-exam.jpg" alt="Conduite supervisée à Échirolles"></picture></figure></div>

                        <div class="course-entry">
                            <p class="wow fadeInUp">Accessible dès 18 ans, la conduite supervisée permet d'acquérir de l'expérience au volant avant de passer l'examen, ou de progresser après un premier échec. Vous conduisez accompagné(e), dans un cadre encadré, pour vous présenter en confiance.</p>
                            <p class="wow fadeInUp" data-wow-delay="0.2s">Elle peut être choisie dès l'inscription à l'auto-école ou après un échec à l'épreuve pratique. Comme pour l'AAC, elle augmente sensiblement les chances de réussite à l'examen.</p>

                            <div class="course-info-box">
                                <h2 class="text-anime-style-3">Les avantages de la conduite supervisée</h2>
                                <p class="wow fadeInUp">Une solution souple pour gagner en expérience à moindre coût et aborder l'examen sereinement.</p>
                                <div class="course-info-item-list">
                                    <div class="course-info-item wow fadeInUp" data-wow-delay="0.2s"><div class="icon-box"><img loading="lazy" decoding="async" src="/images/icon-course-info-item-1.svg" alt=""></div><div class="course-info-item-content"><h3>Plus d'expérience</h3><p>Compléter sa formation initiale et, après un échec, améliorer ses acquis en attendant de repasser.</p></div></div>
                                    <div class="course-info-item wow fadeInUp" data-wow-delay="0.4s"><div class="icon-box"><img loading="lazy" decoding="async" src="/images/icon-course-info-item-2.svg" alt=""></div><div class="course-info-item-content"><h3>Meilleure réussite</h3><p>Environ 74 % de réussite dès la 1re présentation, contre 55 % en filière traditionnelle.</p></div></div>
                                </div>
                                <div class="course-info-images">
                                    <div class="course-info-image"><figure class="image-anime reveal"><picture><source srcset="/images/mc/photo-faq.webp" type="image/webp"><img loading="lazy" decoding="async" src="/images/mc/photo-faq.jpg" alt="Élève en conduite supervisée"></picture></figure></div>
                                    <div class="course-info-image"><figure class="image-anime reveal"><picture><source srcset="/images/mc/photo-road.webp" type="image/webp"><img loading="lazy" decoding="async" src="/images/mc/photo-road.jpg" alt="Conduite supervisée sur route"></picture></figure></div>
                                </div>
                                <p class="wow fadeInUp" data-wow-delay="0.2s">À noter : la période probatoire reste de 3 ans et le tarif d'assurance « jeune conducteur » n'est pas nécessairement préférentiel.</p>
                            </div>

                            <div class="course-types-box">
                                <h2 class="text-anime-style-3">Conditions d'accès</h2>
                                <p class="wow fadeInUp">Deux situations permettent d'opter pour la conduite supervisée.</p>
                                <div class="course-type-item-list">
                                    <div class="course-type-item">
                                        <div class="course-type-content-box wow fadeInUp"><div class="course-type-item-header"><div class="icon-box"><img loading="lazy" decoding="async" src="/images/icon-course-type-1.svg" alt=""></div><div class="course-type-no"><h3>01</h3></div></div><div class="course-type-item-body"><h3>Dès l'inscription</h3><p>Avoir 18 ans, le code réussi, 20 h de conduite minimum et une évaluation favorable.</p><ul><li>Accord écrit de l'assurance requis</li></ul></div></div>
                                        <div class="course-type-image"><figure class="image-anime reveal"><picture><source srcset="/images/mc/photo-exam.webp" type="image/webp"><img loading="lazy" decoding="async" src="/images/mc/photo-exam.jpg" alt="Conduite supervisée dès l'inscription"></picture></figure></div>
                                    </div>
                                    <div class="course-type-item">
                                        <div class="course-type-content-box wow fadeInUp" data-wow-delay="0.2s"><div class="course-type-item-header"><div class="icon-box"><img loading="lazy" decoding="async" src="/images/icon-course-type-2.svg" alt=""></div><div class="course-type-no"><h3>02</h3></div></div><div class="course-type-item-body"><h3>Après un échec à l'examen</h3><p>Reprendre confiance et progresser avant de repasser l'épreuve pratique.</p><ul><li>Autorisation de conduire en supervisée requise</li></ul></div></div>
                                        <div class="course-type-image"><figure class="image-anime reveal"><picture><source srcset="/images/mc/photo-permis-b.webp" type="image/webp"><img loading="lazy" decoding="async" src="/images/mc/photo-permis-b.jpg" alt="Reprise de confiance au volant"></picture></figure></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="page-single-faqs">
                            <div class="section-title"><h2 class="text-anime-style-3" data-cursor="-opaque">Questions fréquentes</h2><p class="wow fadeInUp">Les réponses aux questions les plus courantes sur la conduite supervisée.</p></div>
                            <div class="faq-accordion" id="accordion">
                                <div class="accordion-item wow fadeInUp"><h2 class="accordion-header" id="heading1"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapse1" aria-expanded="true" aria-controls="collapse1">Quelle différence avec la conduite accompagnée ?</button></h2><div id="collapse1" class="accordion-collapse collapse show" role="region" aria-labelledby="heading1" data-bs-parent="#accordion"><div class="accordion-body"><p>La conduite supervisée est accessible dès 18 ans et n'impose pas de durée ni de kilométrage minimum. Contrairement à l'<a href="/conduite-accompagnee">AAC</a>, la période probatoire reste de 3 ans.</p></div></div></div>
                                <div class="accordion-item wow fadeInUp" data-wow-delay="0.2s"><h2 class="accordion-header" id="heading2"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse2" aria-expanded="false" aria-controls="collapse2">Peut-on y passer après un échec à l'examen ?</button></h2><div id="collapse2" class="accordion-collapse collapse" role="region" aria-labelledby="heading2" data-bs-parent="#accordion"><div class="accordion-body"><p>Oui. Avec l'accord écrit de l'assurance et une autorisation de conduire en supervisée, vous pouvez progresser avant de repasser l'épreuve pratique.</p></div></div></div>
                                <div class="accordion-item wow fadeInUp" data-wow-delay="0.4s"><h2 class="accordion-header" id="heading3"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse3" aria-expanded="false" aria-controls="collapse3">Qui peut être accompagnateur ?</button></h2><div id="collapse3" class="accordion-collapse collapse" role="region" aria-labelledby="heading3" data-bs-parent="#accordion"><div class="accordion-body"><p>Toute personne titulaire du permis B depuis au moins 5 ans sans interruption, avec l'accord de son assureur et mentionnée au contrat.</p></div></div></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Page Course Single End -->



    <!-- Avis Google FAB Start -->
    <a class="mc-review-fab" href="https://www.google.com/maps/place/AUTO+ECOLE+MC+CONDUITE/@45.1441566,5.7100222,1331m/data=!3m1!1e3!4m18!1m9!3m8!1s0x478a8b3f6db3fce7:0x4d184686cf363037!2sAUTO+ECOLE+MC+CONDUITE!8m2!3d45.1457321!4d5.7167138!9m1!1b1!16s%2Fg%2F11z21tx4g4!3m7!1s0x478a8b3f6db3fce7:0x4d184686cf363037!8m2!3d45.1457321!4d5.7167138!9m1!1b1!16s%2Fg%2F11z21tx4g4" target="_blank" rel="noopener" aria-label="Laisser un avis sur Google">
        <img loading="lazy" decoding="async" src="/images/icon-google.svg" alt="Google">
        <span class="mc-review-fab-text"><strong>Laissez votre avis</strong><span class="mc-review-fab-stars"><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i></span></span>
    </a>
    <!-- Avis Google FAB End -->
    <!-- Back To Top Start -->
    <a href="#top" class="mc-backtotop" aria-label="Remonter en haut de la page"><i class="fa-solid fa-arrow-up"></i></a>
    <!-- Back To Top End -->

    </main>
</Base>
