---
import Base from '../layouts/Base.astro';
import { formulaire } from '../data/site';

const jsonLd = [
	[
		{
			"@context": "https://schema.org",
			"@type": "BreadcrumbList",
			"itemListElement": [
				{
					"@type": "ListItem",
					"position": 1,
					"name": "Accueil",
					"item": "https://mcconduite.fr/"
				},
				{
					"@type": "ListItem",
					"position": 2,
					"name": "Contact",
					"item": "https://mcconduite.fr/contact"
				}
			]
		}
	]
];
---
<Base
	title={"Contact & pré-inscription — MC Conduite Échirolles"}
	description={"Contactez MC Conduite, auto-moto-école à Échirolles : 26 avenue du 8 mai 1945, 04 38 21 48 02. Formulaire de pré-inscription en ligne pour le permis B et le permis moto."}
	keywords={"contact auto-école Échirolles, pré-inscription permis, MC Conduite Échirolles"}
	path={"/contact"}
	jsonLd={jsonLd}
>
	<main id="contenu">
	<!-- Header End -->

    <!-- Page Header Section Start -->
    <div class="page-header bg-section dark-section parallaxie">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <!-- Page Header Box Start -->
                    <div class="page-header-box">
                        <h1>Contactez-nous</h1>
                        <nav>
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item"><a href="/">Accueil</a></li>
                                <li class="breadcrumb-item active" aria-current="page">Contact</li>
                            </ol>
                        </nav>
                    </div>
                    <!-- Page Header Box End -->
                </div>
            </div>
        </div>
    </div>
    <!-- Page Header Section End -->

    <!-- Map Contact Form Section Start -->
    <div class="map-contact-form-section">
        <div class="container">
            <div class="row section-row">
                <div class="col-lg-12">
                    <!-- Section Title Start -->
                    <div class="section-title section-title-center">
                        <h3 class="wow fadeInUp">Pré-inscription</h3>
                        <h2 class="text-anime-style-3" data-cursor="-opaque">Démarrez votre inscription dès aujourd'hui</h2>
                         <p class="wow fadeInUp" data-wow-delay="0.2s">Remplissez le formulaire ci-dessous : nous vous recontactons rapidement pour faire le point sur votre projet et finaliser votre inscription. C'est sans engagement.</p>
                    </div>
                    <!-- Section Title End -->
                </div>
            </div>

            <div class="row">
                <div class="col-xl-12">
                    <!-- Map Contact Form Box Start -->
                    <div class="map-contact-form-box">
                        <!-- Google Map Iframe Start -->
                        <div class="google-map-iframe wow fadeInUp">
                            <iframe src="https://maps.google.com/maps?q=26%20avenue%20du%208%20mai%201945%2C%2038130%20%C3%89chirolles&t=&z=15&ie=UTF8&iwloc=&output=embed" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Localisation de MC Conduite à Échirolles"></iframe>
                        </div>
                        <!-- Google Map Iframe End -->

                        <!-- Contact Us Form Start -->
                        <div class="contact-us-form">
                            <!-- Contact Form Content Start -->
                            <div class="contact-form-content wow fadeInUp" data-wow-delay="0.2s">
                                <h3>Demande de pré-inscription</h3>
                                <p>Tous les champs marqués d'un astérisque (*) sont obligatoires. Vos données ne sont utilisées que pour traiter votre demande.</p>
                            </div>
                            <!-- Contact Form Content End -->

                            <!-- Contact Form Start -->
                            <div class="contact-form">
                                <form id="contactForm" action={formulaire.endpoint} method="POST" data-sitekey={formulaire.sitekey} data-toggle="validator" class="wow fadeInUp" data-wow-delay="0.4s">
                                    <!-- Envoi par le service de formulaires NETYGO (js/function.js) : champ piège et horodatage, à laisser tels quels -->
                                    <div class="mc-form-piege" aria-hidden="true"><label>Ne pas remplir <input type="text" name="website" tabindex="-1" autocomplete="off"></label></div>
                                    <input type="hidden" name="ts">
                                    <div class="row">
                                        <div class="form-group col-md-12 mb-4">
                                            <label>Civilité :</label>
                                            <select name="civilite" class="form-control" id="civilite" required>
                                                <option value="" selected disabled>Choisir…</option>
                                                <option value="Madame">Madame</option>
                                                <option value="Monsieur">Monsieur</option>
                                            </select>
                                            <div class="help-block with-errors"></div>
                                        </div>

                                        <div class="form-group col-md-6 mb-4">
                                            <label>Prénom * :</label>
                                            <input type="text" name="prenom" class="form-control" id="prenom" placeholder="Votre prénom" required>
                                            <div class="help-block with-errors"></div>
                                        </div>

                                        <div class="form-group col-md-6 mb-4">
                                            <label>Nom * :</label>
                                            <input type="text" name="nom" class="form-control" id="nom" placeholder="Votre nom" required>
                                            <div class="help-block with-errors"></div>
                                        </div>

                                        <div class="form-group col-md-6 mb-4">
                                            <label>Date de naissance :</label>
                                            <input type="date" name="date_naissance" class="form-control" id="naissance">
                                            <div class="help-block with-errors"></div>
                                        </div>

                                        <div class="form-group col-md-6 mb-4">
                                            <label>Téléphone * :</label>
                                            <input type="tel" name="tel" class="form-control" id="phone" placeholder="Votre numéro de téléphone" required>
                                            <div class="help-block with-errors"></div>
                                        </div>

                                        <div class="form-group col-md-6 mb-4">
                                            <label>Email * :</label>
                                            <input type="email" name="email" class="form-control" id="email" placeholder="Votre adresse email" required>
                                            <div class="help-block with-errors"></div>
                                        </div>

                                        <div class="form-group col-md-6 mb-4">
                                            <label>Formation souhaitée * :</label>
                                            <select name="formation" class="form-control" id="formation" required>
                                                <option value="" selected disabled>Choisir une formation…</option>
                                                <option value="Permis B - boîte manuelle">Permis B — boîte manuelle</option>
                                                <option value="Permis B - boîte automatique">Permis B — boîte automatique</option>
                                                <option value="Conduite accompagnée (AAC)">Conduite accompagnée (AAC)</option>
                                                <option value="Conduite supervisée">Conduite supervisée</option>
                                                <option value="Post-permis">Post-permis</option>
                                                <option value="Code de la route">Code de la route</option>
                                                <option value="Permis AM">Permis AM</option>
                                                <option value="Permis A1">Permis A1</option>
                                                <option value="Permis A2">Permis A2</option>
                                                <option value="Permis A L5e">Permis A L5e</option>
                                                <option value="Autre / je ne sais pas encore">Autre / je ne sais pas encore</option>
                                            </select>
                                            <div class="help-block with-errors"></div>
                                        </div>

                                        <div class="form-group col-md-12 mb-4">
                                            <label>Votre message :</label>
                                            <textarea name="message" class="form-control" id="message" rows="5" placeholder="Précisez votre projet, vos disponibilités, vos questions…"></textarea>
                                            <div class="help-block with-errors"></div>
                                        </div>

                                        <div class="form-group col-md-12 mb-4 mc-consent">
                                            <label class="mc-checkbox-label">
                                                <input type="checkbox" name="consentement" id="rgpd" value="Oui" required>
                                                <span>J'accepte que mes données soient utilisées pour traiter ma demande de pré-inscription, conformément à la <a href="/politique-confidentialite">politique de confidentialité</a>. *</span>
                                            </label>
                                            <div class="help-block with-errors"></div>
                                        </div>

                                        <div class="col-md-12">
                                            <div class="mc-turnstile"></div>
                                            <button type="submit" class="btn-default">Envoyer ma pré-inscription</button>
                                            <div id="msgSubmit" class="h3 hidden"></div>
                                        </div>
                                    </div>
                                </form>
                            </div>
                            <!-- Contact Form End -->
                        </div>
                        <!-- Contact Us Form End -->
                    </div>
                    <!-- Map Contact Form Box End -->
                </div>
            </div>
        </div>
    </div>
    <!-- Map Contact Form Section End -->
    
        <!-- Avis Google FAB Start -->
    <a class="mc-review-fab" href="https://www.google.com/maps/place/AUTO+ECOLE+MC+CONDUITE/@45.1441566,5.7100222,1331m/data=!3m1!1e3!4m18!1m9!3m8!1s0x478a8b3f6db3fce7:0x4d184686cf363037!2sAUTO+ECOLE+MC+CONDUITE!8m2!3d45.1457321!4d5.7167138!9m1!1b1!16s%2Fg%2F11z21tx4g4!3m7!1s0x478a8b3f6db3fce7:0x4d184686cf363037!8m2!3d45.1457321!4d5.7167138!9m1!1b1!16s%2Fg%2F11z21tx4g4" target="_blank" rel="noopener" aria-label="Laisser un avis sur Google">
        <img loading="lazy" decoding="async" src="/images/icon-google.svg" alt="Google">
        <span class="mc-review-fab-text"><strong>Laissez votre avis</strong><span class="mc-review-fab-stars"><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i></span></span>
    </a>
    <!-- Avis Google FAB End -->
    <!-- Back To Top Start -->
    <a href="#top" class="mc-backtotop" aria-label="Remonter en haut de la page"><i class="fa-solid fa-arrow-up"></i></a>
    <!-- Back To Top End -->

    </main>
</Base>
